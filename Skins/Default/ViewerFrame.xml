<?xml version="1.0" encoding="UTF-8"?>
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="file:///c|/downloads/UI.xsd">

	<!--- Template: Step Line Text -->
	<FontString name="XPlore_StepLineText_Template" inherits="GameFontHighlightSmall" text="" justifyH="LEFT" justifyV="MIDDLE" virtual="true">
		<Anchors>
			<Anchor point="TOPLEFT" relativePoint="TOPLEFT" />
		</Anchors>
		<Color r="1.0" g="1.0" b="1.0" />
	</FontString>

	<!--- Template: Step Line Icon -->
	<Texture name="XPlore_StepLineIcon_Template" virtual="true">
		<Size x="14" y="14" />
	</Texture>

	<!--- Template: Step Line Background with fade animation -->
	<Frame name="XPlore_StepLineBack_Template" virtual="true">
		<Animations>
			<AnimationGroup parentKey="Fade">
				<Animation duration="0.3" smoothing="OUT">
					<OnUpdate>
						local back = self:GetRegionParent()
						local parent = self:GetParent()
						local progress = self:GetSmoothProgress()
						local r=parent.sr+(parent.r-parent.sr)*progress
						local g=parent.sg+(parent.g-parent.sg)*progress
						local b=parent.sb+(parent.b-parent.sb)*progress
						local a=parent.sa+(parent.a-parent.sa)*progress
						back:SetVertexColor(r,g,b,a)
					</OnUpdate>
					<OnFinished>
						local p = self:GetParent()
						local back = self:GetRegionParent()
						back:SetVertexColor(p.r,p.g,p.b,p.a)
					</OnFinished>
				</Animation>
			</AnimationGroup>
		</Animations>
		<Scripts>
			<OnLoad>self.r,self.g,self.b,self.a = 1,1,1,1; self.sr,self.sg,self.sb,self.sa = 1,1,1,1</OnLoad>
		</Scripts>
	</Frame>

	<!--- Template: Step Line — each step in the scrollable list -->
	<Button name="XPlore_StepLine_Template" virtual="true">
		<Size x="300" y="22" />
		<Frames>
			<Frame inherits="XPlore_StepLineBack_Template" hidden="true" parentKey="back" setAllPoints="true" />
			<Frame setAllPoints="true" parentKey="content">
				<Layers>
					<Layer level="ARTWORK">
						<Texture inherits="XPlore_StepLineIcon_Template" hidden="false" parentKey="icon" />
						<FontString inherits="XPlore_StepLineText_Template" parentKey="label" />
					</Layer>
				</Layers>
			</Frame>
			<Button hidden="false" parentKey="clicker" frameLevel="99" alpha="0.0" setAllPoints="true">
				<Scripts>
					<OnClick>
						local parent = self:GetParent()
						if parent.OnClick then parent:OnClick(button) end
					</OnClick>
					<OnEnter>
						local parent = self:GetParent()
						if parent.OnEnter then parent:OnEnter() end
					</OnEnter>
					<OnLeave>
						local parent = self:GetParent()
						if parent.OnLeave then parent:OnLeave() end
					</OnLeave>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				-- Default state colors
				self.r, self.g, self.b, self.a = 1, 1, 1, 1
				self.sr, self.sg, self.sb, self.sa = 1, 1, 1, 1
			</OnLoad>
		</Scripts>
	</Button>

	<!--- Template: Title Button -->
	<Button name="XPlore_TitleButton_Template" virtual="true">
		<Size x="20" y="20" />
		<NormalTexture parentKey="ntx" />
		<PushedTexture parentKey="ptx" />
		<HighlightTexture parentKey="htx" alphaMode="ADD" />
	</Button>

	<!--- Template: Default Step (single step display with animation) -->
	<Frame name="XPlore_DefaultStep_Template" virtual="true" hidden="true">
		<Animations>
			<AnimationGroup parentKey="slideup">
				<Animation duration="0.3" smoothing="IN_OUT" order="1">
					<OnPlay>
						-- Only for step 1
						self.f = self:GetRegionParent()
						self.f:ClearAllPoints()
						self.offset = 50
					</OnPlay>
					<OnUpdate>
						local off = -self.offset*(1-self:GetSmoothProgress())
						self.f:SetPoint("TOPLEFT",self:GetParent(),"TOPLEFT",0,off)
						self.f:SetPoint("TOPRIGHT",self:GetParent(),"TOPRIGHT",0,off)
					</OnUpdate>
					<OnFinished>
						self.f:SetPoint("TOPLEFT",self:GetParent(),"TOPLEFT",0,0)
						self.f:SetPoint("TOPRIGHT",self:GetParent(),"TOPRIGHT",0,0)
					</OnFinished>
				</Animation>
			</AnimationGroup>
			<AnimationGroup parentKey="fadeout">
				<Alpha duration="2.3" smoothing="NONE" fromAlpha="1" toAlpha="0" order="1">
					<Scripts>
						<OnFinished>
							self:GetRegionParent():Hide()
						</OnFinished>
					</Scripts>
				</Alpha>
			</AnimationGroup>
		</Animations>
		<Frames>
			<Frame parentKey="border" setAllPoints="true" inherits="BackdropTemplate"/>
		</Frames>
	</Frame>

	<!--- Template: Main Viewer Frame -->
	<Frame name="XPlore_ViewerFrame_Template" toplevel="true" hidden="true" movable="true" resizable="true" clampedToScreen="true" virtual="true">
		<Anchors>
			<Anchor point="CENTER" relativePoint="CENTER" />
		</Anchors>
		<Size x="320" y="100" />
		<Frames>
			<!--- Main Border/Backdrop -->
			<Frame parentKey="Border" setAllPoints="true" inherits="BackdropTemplate">
				<Frames>
					<!--- Title Bar -->
					<Frame parentKey="TitleBar">
						<KeyValues>
							<KeyValue key="GenericDrag" value="true" type="boolean"/>
						</KeyValues>
						<Size x="150" y="30" />
						<Anchors>
							<Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="0" />
							<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="0" y="0" />
						</Anchors>
						<Layers>
							<Layer level="ARTWORK">
								<Texture parentKey="Logo">
									<KeyValues><KeyValue key="SkinTexture" value="TitleLogo" type="string"/></KeyValues>
									<Size x="120" y="30" />
									<Anchors>
										<Anchor point="CENTER" relativePoint="CENTER" />
									</Anchors>
								</Texture>
							</Layer>
						</Layers>
						<Frames>
							<Button parentKey="CloseButton" inherits="XPlore_TitleButton_Template">
								<KeyValues>
									<KeyValue key="GenericDrag" value="true" type="boolean"/>
									<KeyValue key="buttonkey" value="CLOSE" type="string"/>
								</KeyValues>
								<Anchors>
									<Anchor point="CENTER" relativePoint="RIGHT" x="-15" y="0" />
								</Anchors>
							</Button>
							<Button parentKey="MenuButton" inherits="XPlore_TitleButton_Template">
								<KeyValues>
									<KeyValue key="GenericDrag" value="true" type="boolean"/>
									<KeyValue key="buttonkey" value="LIST" type="string"/>
								</KeyValues>
								<Anchors>
									<Anchor point="CENTER" relativePoint="RIGHT" x="-55" y="0" />
								</Anchors>
							</Button>
						</Frames>
					</Frame>

					<!--- Tab Container -->
					<Frame parentKey="TabContainer" inherits="BackdropTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="30" />
						</Anchors>
						<Size x="150" y="28" />
					</Frame>

					<!--- Toolbar -->
					<Frame parentKey="Toolbar" inherits="BackdropTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" x="5" y="58" />
						</Anchors>
						<Size x="20" y="22" />
						<Frames>
							<Button parentKey="PrevButton" inherits="XPlore_TitleButton_Template">
								<KeyValues>
									<KeyValue key="GenericDrag" value="true" type="boolean"/>
									<KeyValue key="buttonkey" value="STEP_PREV" type="string"/>
								</KeyValues>
								<Anchors>
									<Anchor point="CENTER" relativePoint="LEFT" x="15" y="0" />
								</Anchors>
							</Button>
							<Frame parentKey="StepNum">
								<Size x="24" y="20" />
								<Anchors>
									<Anchor point="LEFT" relativeKey="$parent.PrevButton" relativePoint="RIGHT" x="-1" y="0" />
								</Anchors>
								<Layers>
									<Layer level="OVERLAY">
										<FontString parentKey="Step" inherits="GameFontHighlightSmall" justifyH="CENTER" justifyV="MIDDLE" text="" setAllPoints="true">
											<Size x="25" y="14" />
										</FontString>
									</Layer>
								</Layers>
								<Scripts>
									<OnLoad>self:EnableMouseWheel() self:RegisterForDrag("LeftButton")</OnLoad>
									<OnMouseWheel>-- Scrolling handled by parent</OnMouseWheel>
								</Scripts>
							</Frame>
							<Button parentKey="NextButton" inherits="XPlore_TitleButton_Template">
								<KeyValues>
									<KeyValue key="buttonkey" value="STEP_NEXT" type="string"/>
								</KeyValues>
								<Anchors>
									<Anchor point="LEFT" relativeKey="$parent.StepNum" relativePoint="RIGHT" x="-1" y="0" />
								</Anchors>
							</Button>
							<Button parentKey="NextButtonSpecial" inherits="XPlore_TitleButton_Template">
								<KeyValues>
									<KeyValue key="buttonkey" value="RIGHTRIGHT" type="string"/>
								</KeyValues>
								<Anchors>
									<Anchor point="LEFT" relativeKey="$parent.StepNum" relativePoint="RIGHT" x="21" y="0" />
								</Anchors>
								<Animations>
									<AnimationGroup parentKey="Blink" setToFinalAlpha="true">
										<Alpha fromAlpha="1"   toAlpha="0.5" duration=".1" order="1"/>
										<Alpha fromAlpha="0.5" toAlpha="0.5" duration=".5" order="2"/>
										<Alpha fromAlpha="0.5" toAlpha="1"   duration=".1" order="3"/>
									</AnimationGroup>
								</Animations>
							</Button>
						</Frames>
					</Frame>

					<!--- Flash Animation Frame -->
					<Frame alpha="0.0" parentKey="Flash">
						<Anchors>
							<Anchor point="TOPLEFT" />
							<Anchor point="BOTTOMRIGHT" />
						</Anchors>
						<Frames>
							<Frame parentKey="sub">
								<Anchors>
									<Anchor point="TOPLEFT" />
									<Anchor point="BOTTOMRIGHT" />
								</Anchors>
								<Animations>
									<AnimationGroup parentKey="flash" looping="NONE">
										<Scripts>
											<OnPlay>self:GetParent():GetParent():SetAlpha(0.5)</OnPlay>
											<OnFinished>self:GetParent():GetParent():SetAlpha(0)</OnFinished>
										</Scripts>
										<Alpha parentKey="flashPre" duration="0" fromAlpha="1" toAlpha="0"  />
										<Alpha parentKey="flashIn" duration="0.0" smoothing="IN" fromAlpha="0" toAlpha="1"  />
										<Alpha parentKey="flashOut" duration="1.0" smoothing="OUT" fromAlpha="1" toAlpha="0"  />
									</AnimationGroup>
								</Animations>
							</Frame>
						</Frames>
					</Frame>

					<!--- Scroll Frame -->
					<ScrollFrame parentKey="Scroll" hidden="true">
						<Anchors>
							<Anchor point="TOPLEFT" />
							<Anchor point="BOTTOMRIGHT" />
						</Anchors>
						<Frames>
							<Slider parentKey="Bar" inherits="UIPanelScrollBarTemplate">
								<Anchors>
									<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="0" y="-16" />
									<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="0" y="16" />
								</Anchors>
							</Slider>
						</Frames>
						<ScrollChild>
							<Frame setAllPoints="true" parentKey="StepContainer" clipChildren="true">
								<Size x="300" y="50" />
							</Frame>
						</ScrollChild>
					</ScrollFrame>
				</Frames>
			</Frame>

			<!--- Thin Flash Overlay -->
			<Frame frameLevel="110" hidden="true" parentKey="ThinFlash" inherits="BackdropTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Scroll" relativePoint="TOPLEFT" x="-18" y="18" />
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Scroll" relativePoint="BOTTOMRIGHT" x="18" y="-18" />
				</Anchors>
				<Animations>
					<AnimationGroup parentKey="flash" looping="NONE">
						<Scripts>
							<OnPlay>self:GetParent():SetAlpha(1)</OnPlay>
							<OnFinished>self:GetParent():SetAlpha(0)</OnFinished>
						</Scripts>
						<Animation parentKey="flashOut" duration="0.4" smoothing="OUT">
							<OnUpdate>self:GetRegionParent():SetAlpha(1-self:GetSmoothProgress())</OnUpdate>
						</Animation>
					</AnimationGroup>
				</Animations>
			</Frame>

			<!--- Resizer Frames -->
			<Frame parentKey="ResizerLeft" frameLevel="100">
				<KeyValues><KeyValue key="ResizerDir" value="LEFT" type="string"/></KeyValues>
				<Size x="6" y="6" />
				<Anchors>
					<Anchor point="TOP" relativePoint="TOPLEFT" />
					<Anchor point="BOTTOM" relativePoint="BOTTOMLEFT" />
				</Anchors>
			</Frame>
			<Frame parentKey="ResizerRight" frameLevel="100">
				<KeyValues><KeyValue key="ResizerDir" value="RIGHT" type="string"/></KeyValues>
				<Size x="6" y="6" />
				<Anchors>
					<Anchor point="TOP" relativePoint="TOPRIGHT" x="1" y="0" />
					<Anchor point="BOTTOM" relativePoint="BOTTOMRIGHT" x="1" y="0" />
				</Anchors>
			</Frame>
			<Frame parentKey="ResizerBottom" frameLevel="100">
				<KeyValues><KeyValue key="ResizerDir" value="BOTTOM" type="string"/></KeyValues>
				<Size x="10" y="10" />
			</Frame>
			<Frame parentKey="ResizerBottomLeft" frameLevel="101">
				<KeyValues><KeyValue key="ResizerDir" value="BOTTOMLEFT" type="string"/></KeyValues>
				<Size x="10" y="10" />
			</Frame>
			<Frame parentKey="ResizerBottomRight" frameLevel="101">
				<KeyValues><KeyValue key="ResizerDir" value="BOTTOMRIGHT" type="string"/></KeyValues>
				<Size x="10" y="10" />
			</Frame>
		</Frames>
	</Frame>

</Ui>
