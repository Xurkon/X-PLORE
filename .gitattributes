# Auto-detect text files
* text=auto

# Binary files — don't attempt to diff/merge
*.png binary
*.tga binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.ogg binary

# Export-ignore: exclude these from release archives (git archive)
.env.example export-ignore
PARITY_REPORT.md export-ignore
PROGRESS.md export-ignore

# Ensure consistent line endings
*.lua text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toc text eol=lf
*.xsl text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
