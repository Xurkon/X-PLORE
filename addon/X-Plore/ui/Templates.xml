<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <!-- Modern Button Template -->
    <Button name="XPlore_ModernButtonTemplate" virtual="true">
        <Size x="80" y="24"/>
        <Backdrop bgFile="Interface\Buttons\WHITE8X8" edgeFile="Interface\Buttons\WHITE8X8" tile="true">
            <EdgeSize val="1"/>
            <TileSize val="8"/>
            <BackgroundInsets left="1" right="1" top="1" bottom="1"/>
        </Backdrop>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentHighlight" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="1" y="-1"/>
                        <Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
                    </Anchors>
                    <Color r="0" g="0.9" b="1.0" a="0.1"/>
                </Texture>
            </Layer>
        </Layers>
        <ButtonText name="$parentText" inherits="GameFontNormalSmall">
            <Anchors>
                <Anchor point="CENTER"/>
            </Anchors>
        </ButtonText>
        <NormalFont inherits="GameFontNormalSmall"/>
        <HighlightFont inherits="GameFontHighlightSmall"/>
        <Scripts>
            <OnLoad>
                self:SetBackdropColor(0.04, 0.07, 0.16, 0.8)
                self:SetBackdropBorderColor(0, 0.9, 1.0, 0.3)
            </OnLoad>
            <OnEnter>
                self:SetBackdropBorderColor(0, 0.9, 1.0, 1.0)
                _G[self:GetName().."Highlight"]:Show()
            </OnEnter>
            <OnLeave>
                self:SetBackdropBorderColor(0, 0.9, 1.0, 0.3)
                _G[self:GetName().."Highlight"]:Hide()
            </OnEnter>
            <OnMouseDown>
                self:SetBackdropColor(0, 0.9, 1.0, 0.1)
            </OnMouseDown>
            <OnMouseUp>
                self:SetBackdropColor(0.04, 0.07, 0.16, 0.8)
            </OnMouseUp>
        </Scripts>
    </Button>
</Ui>
