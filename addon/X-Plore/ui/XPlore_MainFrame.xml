<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Frame name="XPlore_MainFrame" parent="UIParent" movable="true" enableMouse="true" hidden="false">
        <Size x="320" y="450"/>
        <Anchors>
            <Anchor point="CENTER" x="0" y="0"/>
        </Anchors>
        
        <!-- Native Backdrop -> Managed by Lua to prevent taint and allow dynamic updates -->
        <Backdrop bgFile="Interface\Buttons\WHITE8X8" edgeFile="Interface\Buttons\WHITE8X8" tile="true">
            <EdgeSize val="1"/>
            <TileSize val="8"/>
            <BackgroundInsets left="1" right="1" top="1" bottom="1"/>
        </Backdrop>
        
        <Frames>
            <!-- 1. TITLE BAR -->
            <Frame name="$parentTitleBar" enableMouse="true">
                <Size x="320" y="32"/>
                <Anchors><Anchor point="TOPLEFT"/><Anchor point="TOPRIGHT"/></Anchors>
                <Scripts>
                    <OnLoad>self:RegisterForDrag("LeftButton")</OnLoad>
                    <OnDragStart>self:GetParent():StartMoving()</OnDragStart>
                    <OnDragStop>self:GetParent():StopMovingOrSizing()</OnDragStop>
                </Scripts>
                <Layers>
                    <Layer level="ARTWORK">
                        <!-- Icon -->
                        <Texture name="$parentLogoIcon">
                            <Size x="18" y="18"/>
                            <Anchors><Anchor point="LEFT" x="8" y="0"/></Anchors>
                            <Color r="0.0" g="0.90" b="1.0" a="1.0"/>
                        </Texture>
                        <FontString name="$parentLogoText" text="X-PLORE VIEWER" justifyH="LEFT" inherits="GameFontNormalSmall">
                            <Anchors><Anchor point="LEFT" relativeTo="$parentLogoIcon" relativePoint="RIGHT" x="6" y="0"/></Anchors>
                            <Color r="0.0" g="0.90" b="1.0" a="1.0"/>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <!-- Close Button -->
                    <Button name="$parentCloseBtn" inherits="XPlore_ModernButtonTemplate">
                        <Size x="20" y="20"/>
                        <Anchors><Anchor point="RIGHT" x="-8" y="0"/></Anchors>
                        <Scripts>
                            <OnLoad>
                                self:SetBackdropBorderColor(0.9, 0.2, 0.2, 0.6)
                                self:SetText("x")
                            </OnLoad>
                            <OnClick>self:GetParent():GetParent():Hide()</OnClick>
                        </Scripts>
                    </Button>
                    <Button name="$parentOptsBtn" inherits="XPlore_ModernButtonTemplate">
                        <Size x="20" y="20"/>
                        <Anchors><Anchor point="RIGHT" relativeTo="$parentCloseBtn" relativePoint="LEFT" x="-4" y="0"/></Anchors>
                        <Scripts>
                            <OnLoad>
                                self:SetBackdropBorderColor(0.0, 0.59, 0.65, 0.6)
                                self:SetText("O")
                            </OnLoad>
                            <OnClick>if XPlore_BrowserFrame then XPlore_BrowserFrame:Show() end</OnClick>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>
            
            <!-- Horizontal Divider 1 -->
            <Frame name="$parentDiv1">
                <Size y="1"/>
                <Anchors><Anchor point="TOPLEFT" y="-32"/><Anchor point="TOPRIGHT" y="-32"/></Anchors>
                <Layers><Layer level="BACKGROUND"><Texture file="Interface\Buttons\WHITE8X8"><Color r="0.0" g="0.59" b="0.65" a="0.4"/></Texture></Layer></Layers>
            </Frame>

            <!-- 2. NAV TABS placeholder -->
            <Frame name="$parentNavTabs">
                <Size y="32"/>
                <Anchors><Anchor point="TOPLEFT" y="-33"/><Anchor point="TOPRIGHT" y="-33"/></Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture file="Interface\Buttons\WHITE8X8"><Color r="0.0" g="0.0" b="0.0" a="0.3"/></Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <Frame name="$parentActiveTab">
                        <Size x="180" y="32"/>
                        <Anchors><Anchor point="TOPLEFT" x="8" y="0"/></Anchors>
                        <Layers>
                            <Layer level="BACKGROUND">
                                <Texture file="Interface\Buttons\WHITE8X8"><Color r="0.05" g="0.08" b="0.15" a="1.0"/></Texture>
                            </Layer>
                            <Layer level="ARTWORK">
                                <FontString name="$parentText" text="XP ALLIANCE LEVELING..." justifyH="LEFT" inherits="GameFontNormalSmall">
                                    <Anchors><Anchor point="LEFT" x="10" y="0"/></Anchors>
                                    <Color r="0.0" g="0.90" b="1.0" a="1.0"/>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                </Frames>
            </Frame>

            <Frame name="$parentDiv2">
                <Size y="1"/>
                <Anchors><Anchor point="TOPLEFT" y="-65"/><Anchor point="TOPRIGHT" y="-65"/></Anchors>
                <Layers><Layer level="BACKGROUND"><Texture file="Interface\Buttons\WHITE8X8"><Color r="0.0" g="0.59" b="0.65" a="0.4"/></Texture></Layer></Layers>
            </Frame>

            <!-- 3. CATEGORY HEADER -->
            <Frame name="$parentCatHeader">
                <Size y="30"/>
                <Anchors><Anchor point="TOPLEFT" y="-66"/><Anchor point="TOPRIGHT" y="-66"/></Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture file="Interface\Buttons\WHITE8X8"><Color r="0.05" g="0.08" b="0.15" a="1.0"/></Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString name="$parentTitle" text="ALLIANCE LEVELING 1-60" justifyH="LEFT" inherits="GameFontNormalSmall">
                            <Anchors><Anchor point="LEFT" x="12" y="0"/></Anchors>
                            <Color r="0.0" g="0.90" b="1.0" a="1.0"/>
                        </FontString>
                        <FontString name="$parentProgressText" text="1 / 1" justifyH="RIGHT" inherits="GameFontNormalSmall">
                            <Anchors><Anchor point="RIGHT" x="-12" y="0"/></Anchors>
                            <Color r="0.0" g="0.59" b="0.65" a="1.0"/>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- 4. CONTENT AREA & ACTIVE STEP -->
            <Frame name="$parentContent">
                <Anchors>
                    <Anchor point="TOPLEFT" y="-96"/>
                    <Anchor point="BOTTOMRIGHT" y="-40"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture file="Interface\Buttons\WHITE8X8"><Color r="0.05" g="0.08" b="0.15" a="1.0"/></Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <Frame name="$parentActiveStep">
                        <Size y="110"/>
                        <Anchors>
                            <Anchor point="TOPLEFT" x="10" y="-10"/>
                            <Anchor point="TOPRIGHT" x="-10" y="-10"/>
                        </Anchors>
                        <Backdrop bgFile="Interface\Buttons\WHITE8X8" edgeFile="Interface\Buttons\WHITE8X8" tile="true">
                            <EdgeSize val="1"/><TileSize val="8"/><BackgroundInsets left="1" right="1" top="1" bottom="1"/>
                        </Backdrop>
                        <Scripts>
                            <OnLoad>
                                self:SetBackdropColor(0.38, 0.65, 0.98, 0.06)
                                self:SetBackdropBorderColor(0.0, 0.9, 1.0, 0.4)
                            </OnLoad>
                        </Scripts>
                        <Layers>
                            <Layer level="ARTWORK">
                                <!-- Left Blue Edge Indicator -->
                                <Texture file="Interface\Buttons\WHITE8X8">
                                    <Size x="3"/>
                                    <Anchors><Anchor point="TOPLEFT"/><Anchor point="BOTTOMLEFT"/></Anchors>
                                    <Color r="0.0" g="0.90" b="1.0" a="1.0"/>
                                </Texture>
                                
                                <!-- Alert Icon box -->
                                <Texture name="$parentIcon" file="Interface\Buttons\WHITE8X8">
                                    <Size x="20" y="20"/>
                                    <Anchors><Anchor point="TOPLEFT" x="12" y="-16"/></Anchors>
                                    <Color r="0.0" g="0.90" b="1.0" a="1.0"/>
                                </Texture>

                                <!-- We rigidly anchor the Title to the RIGHT of the icon, expanding to the frame bound -->
                                <FontString name="$parentTitle" text="Accept: Beating Them Back!" justifyH="LEFT" justifyV="TOP" inherits="GameFontNormalLarge">
                                    <Anchors>
                                        <Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT" x="10" y="0"/>
                                        <Anchor point="TOPRIGHT" x="-12" y="-16"/>
                                    </Anchors>
                                    <Color r="0.88" g="0.94" b="1.0" a="1.0"/>
                                </FontString>

                                <!-- Desc anchored below Title -->
                                <FontString name="$parentDesc" text="Speak with Marshal McBride at the Northshire Abbey entrance." justifyH="LEFT" justifyV="TOP" inherits="GameFontHighlightSmall">
                                    <Anchors>
                                        <Anchor point="TOPLEFT" relativeTo="$parentTitle" relativePoint="BOTTOMLEFT" x="0" y="-6"/>
                                        <Anchor point="RIGHT" x="-12" y="0"/>
                                    </Anchors>
                                    <Color r="0.58" g="0.72" b="0.83" a="1.0"/>
                                </FontString>
                            </Layer>
                        </Layers>
                        <Frames>
                            <!-- Objective Checkbox Frame nested inside ActiveStep -->
                            <Frame name="$parentObjective1">
                                <Size y="20"/>
                                <Anchors>
                                    <Anchor point="TOPLEFT" relativeTo="$parentDesc" relativePoint="BOTTOMLEFT" x="0" y="-12"/>
                                    <Anchor point="TOPRIGHT" x="-12" y="-12"/>
                                </Anchors>
                                <Layers>
                                    <Layer level="ARTWORK">
                                        <FontString name="$parentText" text="[] Talk to Marshal McBride" justifyH="LEFT" inherits="GameFontHighlightSmall">
                                            <Anchors><Anchor point="LEFT" x="30" y="0"/></Anchors>
                                            <Color r="0.58" g="0.72" b="0.83" a="1.0"/>
                                        </FontString>
                                        <FontString name="$parentProgress" text="0/1" justifyH="RIGHT" inherits="GameFontHighlightSmall">
                                            <Anchors><Anchor point="RIGHT" x="-4" y="0"/></Anchors>
                                            <Color r="0.58" g="0.72" b="0.83" a="1.0"/>
                                        </FontString>
                                    </Layer>
                                </Layers>
                            </Frame>
                        </Frames>
                    </Frame>
                    
                    <!-- Accordion Dropdown Placeholder -->
                    <Frame name="$parentNextStepAccordion">
                        <Size y="26"/>
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="$parentActiveStep" relativePoint="BOTTOMLEFT" x="0" y="-12"/>
                            <Anchor point="TOPRIGHT" relativeTo="$parentActiveStep" relativePoint="BOTTOMRIGHT" x="0" y="-12"/>
                        </Anchors>
                        <Layers>
                            <Layer level="BACKGROUND">
                                <Texture file="Interface\Buttons\WHITE8X8"><Color r="0.0" g="0.0" b="0.0" a="0.2"/></Texture>
                            </Layer>
                            <Layer level="ARTWORK">
                                <FontString text="NEXT STEP" justifyH="LEFT" inherits="GameFontNormalSmall">
                                    <Anchors><Anchor point="LEFT" x="12" y="0"/></Anchors>
                                    <Color r="0.0" g="0.59" b="0.65" a="1.0"/>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                </Frames>
            </Frame>
            
            <Frame name="$parentDiv3">
                <Size y="1"/>
                <Anchors><Anchor point="TOPLEFT" y="-370"/><Anchor point="TOPRIGHT" y="-370"/></Anchors>
                <Layers><Layer level="BACKGROUND"><Texture file="Interface\Buttons\WHITE8X8"><Color r="0.0" g="0.59" b="0.65" a="0.2"/></Texture></Layer></Layers>
            </Frame>

            <!-- 5. PROGRESS ROW -->
            <Frame name="$parentProgressWrapper">
                <Size y="40"/>
                <Anchors><Anchor point="BOTTOMLEFT" y="-40"/><Anchor point="BOTTOMRIGHT" y="-40"/></Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture file="Interface\Buttons\WHITE8X8"><Color r="0.0" g="0.0" b="0.0" a="0.2"/></Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString name="$parentPercent" text="100%" justifyH="RIGHT" inherits="GameFontNormalSmall">
                            <Anchors><Anchor point="RIGHT" x="-12" y="0"/></Anchors>
                            <Color r="0.0" g="0.59" b="0.65" a="1.0"/>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <StatusBar name="$parentBar" drawLayer="BORDER">
                        <Size y="8"/>
                        <Anchors>
                            <Anchor point="LEFT" x="12" y="0"/>
                            <Anchor point="RIGHT" x="-50" y="0"/>
                        </Anchors>
                        <BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
                        <BarColor r="0.0" g="0.90" b="1.0" a="1.0"/>
                        <Scripts>
                            <OnLoad>
                                self:SetMinMaxValues(0, 100)
                                self:SetValue(100)
                            </OnLoad>
                        </Scripts>
                    </StatusBar>
                </Frames>
            </Frame>

            <!-- 6. CONTROLS FOOTER -->
            <Frame name="$parentControls">
                <Size y="40"/>
                <Anchors><Anchor point="BOTTOMLEFT" y="0"/><Anchor point="BOTTOMRIGHT" y="0"/></Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture file="Interface\Buttons\WHITE8X8"><Color r="0.05" g="0.08" b="0.15" a="1.0"/></Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString text="AUTO-SYNC" inherits="GameFontNormalSmall">
                            <Anchors><Anchor point="CENTER" x="6" y="0"/></Anchors>
                            <Color r="0.0" g="0.59" b="0.65" a="1.0"/>
                        </FontString>
                        <Texture name="$parentAutoSyncDot" file="Interface\Buttons\WHITE8X8">
                            <Size x="6" y="6"/>
                            <Anchors><Anchor point="RIGHT" relativePoint="CENTER" x="-32" y="0"/></Anchors>
                            <Color r="0.29" g="0.87" b="0.50" a="1.0"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <Button name="XPlore_MainFramePrevBtn" inherits="XPlore_ModernButtonTemplate">
                        <Size x="32" y="24"/>
                        <Anchors><Anchor point="LEFT" x="12" y="0"/></Anchors>
                        <Scripts>
                            <OnLoad>self:SetText("&lt;")</OnLoad>
                            <OnClick>if XPlore_Engine then XPlore_Engine:PrevStep() end</OnClick>
                        </Scripts>
                    </Button>
                    <Button name="XPlore_MainFrameNextBtn" inherits="XPlore_ModernButtonTemplate">
                        <Size x="32" y="24"/>
                        <Anchors><Anchor point="RIGHT" x="-12" y="0"/></Anchors>
                        <Scripts>
                            <OnLoad>self:SetText("&gt;")</OnLoad>
                            <OnClick>if XPlore_Engine then XPlore_Engine:NextStep() end</OnClick>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>
