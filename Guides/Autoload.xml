    <Script file="Dailies\ZygorDailiesHordeCATA.lua"/>
    <Script file="Dailies\ZygorDailiesHordeMOP.lua"/>

    <!-- ── Dungeons ─────────────────────────────────────────────────── -->
    <Script file="Dungeons\ZygorGearCommon.lua"/>
