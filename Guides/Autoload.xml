<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <!--
        X-Plore: Guides/Autoload.xml
        Lists all guide data files to load. Files call ZygorGuidesViewer:RegisterGuide()
        which is intercepted by GuideLoader.lua's shim and forwarded to XP:RegisterGuide().

        Load order mirrors Zygor's Autoload.xml pattern:
          1. Common / shared includes first
          2. Named guide bundles (Alliance, Horde, Dailies, etc.)
          3. User guide slots (Guide##.lua)
          4. Subfolders (Leveling, Dailies, Dungeons, Achievements, etc.)
    -->

    <!-- ── Common / Shared ─────────────────────────────────────────── -->
    <Script file="ZygorCommon.lua"/>
    <Script file="ZygorMacros.lua"/>
    <Script file="Images\Images.lua"/>

    <!-- ── Leveling (Alliance & Horde root bundles) ────────────────── -->
    <Script file="ZygorGuidesAlliance.lua"/>
    <Script file="ZygorGuidesHorde.lua"/>
    <Script file="ZygorIncludesAlliance.lua"/>
    <Script file="ZygorIncludesHorde.lua"/>

    <!-- ── Dailies (root bundles) ──────────────────────────────────── -->
    <Script file="ZygorDailiesAlliance.lua"/>
    <Script file="ZygorDailiesHorde.lua"/>

    <!-- ── Achievements (root bundle) ─────────────────────────────── -->
    <Script file="ZygorAchievementAlliance.lua"/>

    <!-- ── User Guide Slots (Guide01..GuideNN) ─────────────────────── -->
    <Script file="Guide01.lua"/>
    <Script file="Guide02.lua"/>

    <!-- ── Test / Sample Guides ─────────────────────────────────────── -->
    <Script file="Test_Alliance_1_10.lua"/>
    <Script file="Test_Horde_1_10.lua"/>
    <Script file="Test_Classic_1_10.lua"/>
    <Script file="Test_TBC_60_70.lua"/>
    <Script file="Test_WotLK_68_80.lua"/>

    <!-- ── Leveling (subfolder) ─────────────────────────────────────── -->
    <Script file="Leveling\Guide40.lua"/>
    <Script file="Leveling\ZygorLevelingAllianceCATA.lua"/>
    <Script file="Leveling\ZygorLevelingAllianceMOP.lua"/>
    <Script file="Leveling\ZygorLevelingHordeCATA.lua"/>
    <Script file="Leveling\ZygorLevelingHordeMOP.lua"/>
    <Script file="Leveling\ZygorLevelingPandaStarterMOP.lua"/>

    <!-- ── Dailies (subfolder) ──────────────────────────────────────── -->
    <Script file="Dailies\ZygorDailiesAllianceCATA.lua"/>
